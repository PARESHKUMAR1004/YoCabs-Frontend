# Copy to .env for local development. EXPO_PUBLIC_* values are embedded in the app bundle: never put secrets here.

# API base URL.
#   Android emulator -> http://10.0.2.2:8080
#   Physical device  -> http://<your computer's LAN IP>:8080
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Show the "simulate payment" step (only works when the API runs with the sandbox payment gateway).
EXPO_PUBLIC_SANDBOX_PAYMENTS=true

# Place search: static (built-in Odisha places), osm (OpenStreetMap Nominatim) or hybrid (both).
EXPO_PUBLIC_PLACES_PROVIDER=hybrid

# Google Maps key for the Android SDK, used by development and store builds only (Expo Go supplies
# its own). Create it in Google Cloud > Maps SDK for Android, restrict it to the app's package and
# signing certificate, and set it as an EAS secret rather than committing it.
GOOGLE_MAPS_API_KEY=
